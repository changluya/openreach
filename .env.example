# OpenReach v0.1.3 Docker Compose runtime configuration
# Copy to .env and change the credential values before production deployment.

OPENREACH_IMAGE=codercl/openreach:0.1.3
APP_PORT=8080
OPENREACH_DATA_DIR=./data
OPENREACH_LOG_DIR=./logs

# Internal monitor console credentials. Defaults are openreach/openreach when omitted.
OPENREACH_MONITOR_USERNAME=openreach
OPENREACH_MONITOR_PASSWORD=openreach

# Optional runtime settings
OPENREACH_MONITOR_PERSISTENCE_ENABLED=true
JAVA_OPTS=-Xms128m -Xmx512m
